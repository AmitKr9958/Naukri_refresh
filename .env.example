PROFILE_URL=https://www.naukri.com/mnjuser/profile
RESUME_PATH=C:\\Users\\YOUR_NAME\\Documents\\Resume.pdf
# Production cadence used by the scheduled task (preserve 5 unless intentionally changed)
REFRESH_INTERVAL_MINUTES=5
HEADLESS=false
MAX_CONSECUTIVE_FAILURES=3

# Chromium launch handshake timeout (ms). Raise if antivirus or large profiles slow CDP connect.
BROWSER_LAUNCH_TIMEOUT_MS=90000

# Optional email alerts for failures
ALERT_EMAIL=your-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-gmail-app-password
ALERT_COOLDOWN_MINUTES=60
NOTIFICATION_TIMEOUT_MS=15000


# Optional Telegram notifications after each completed refresh cycle and on failures/recovery
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Runtime diagnostics
LOG_MAX_BYTES=5242880
DEBUG_PROFILE_UI=false
