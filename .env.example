PROFILE_URL=https://www.naukri.com/mnjuser/profile
RESUME_PATH=C:\\Users\\YOUR_NAME\\Documents\\Resume.pdf
REFRESH_INTERVAL_MINUTES=20
HEADLESS=false
MAX_CONSECUTIVE_FAILURES=3

# Optional email alerts for failures
ALERT_EMAIL=your-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-gmail-app-password
ALERT_COOLDOWN_MINUTES=60


# Optional WhatsApp success heartbeat after each completed refresh cycle
# Requires WhatsApp Business Cloud API credentials.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=your-whatsapp-cloud-api-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-business-phone-number-id
WHATSAPP_RECIPIENT_PHONE=919XXXXXXXXX
WHATSAPP_GRAPH_VERSION=v23.0
